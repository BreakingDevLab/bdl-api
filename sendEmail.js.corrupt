/**
 * sendEmail.js
 * Brevo HTTP helper with retry and SMTP fallback orchestration.
 * Exports: trySendEmail(payload) -> { ok, via, reason, meta }
 *
 * Requires Node 18+ (fetch available) or install node-fetch and set fetch global.
 */

const BREVO_API = 'https://api.brevo.com/v3/smtp/email';
const fetchFn = (typeof fetch !== 'undefined') ? fetch : require('node-fetch');

async function sendViaBrevoHttp({ to, subject, text, html, senderName, senderEmail }) {
  if (!process.env.BREVO_API_KEY) {
    const e = new Error('no-brevo-key');
    e.code = 'no-brevo-key';
    throw e;
  }

  const toArray = Array.isArray(to)
    ? to.map(t => (typeof t === 'string' ? { email: t } : t))
    : [{ email: to }];

  const body = {
    sender: { name: senderName || 'BDL', email: senderEmail || process.env.EMAIL_FROM },
    to: toArray,
    subject,
    htmlContent: html,
    textContent: text
  };

  const res = await fetchFn(BREVO_API, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'api-key': process.env.BREVO_API_KEY },
    body: JSON.stringify(body)
  });

  const textBody = await res.text().catch(() => null);
  let parsed;
  try { parsed = JSON.parse(textBody); } catch (e) { parsed = textBody; }

  if (!res.ok) {
    const debugInfo = {
      status: res.status,
      statusText: res.statusText,
      headers: Object.fromEntries(res.headers),
      requestBody: body,
      body: parsed
    };
    console.error('Brevo response debug', JSON.stringify(debugInfo, null, 2));
    const err = new Error('brevo-error');
    err.status = res.status;
    err.body = parsed;
    throw err;
  }

  return { status: res.status, body: parsed };
}

function isTransientBrevoError(err) {
  if (!err) return false;
  if (!err.status) return true;
  return err.status >= 500 || err.status === 429;
}

async function tryBrevoWithRetry(payload, attempts = 3) {
  let delay = 500;
  for (let i = 0; i < attempts; i++) {
    try {
      return await sendViaBrevoHttp(payload);
    } catch (err) {
      const transient = isTransientBrevoError(err);
      console.error(\`Brevo attempt \${i+1} failed\`, err && (err.status || err.message));
      if (!transient) throw err;
      if (i < attempts - 1) await new Promise(r => setTimeout(r, delay));
      delay *= 2;
    }
  }
  const e = new Error('brevo-retries-exhausted');
  e.code = 'brevo-retries-exhausted';
  throw e;
}

/**
 * trySendEmail(payload)
 * payload: { to, name, email, phone, details, senderName, senderEmail, subject, text, html }
 * returns: { ok, via, reason, meta }
 */
async function trySendEmail(payload) {
  const { to, name, email, phone, details, senderName, senderEmail } = payload;
  const subject = payload.subject || \`New quote request from \${name || 'Unknown'}\`;
  const text = payload.text || [
    \`Name: \${name || 'N/A'}\`,
    \`Email: \${email || 'N/A'}\`,
    \`Phone: \${phone || 'N/A'}\`,
    '',
    details || ''
  ].join('\\n');
  const html = payload.html || \`<h3>New quote request</h3>
    <p><strong>Name:</strong> \${name || 'N/A'}</p>
    <p><strong>Email:</strong> \${email || 'N/A'}</p>
    <p><strong>Phone:</strong> \${phone || 'N/A'}</p>
    <h4>Details</h4><p>\${(details || '').replace(/\\n/g,'<br>')}</p>\`;

  const brevoPayload = { to: to || process.env.EMAIL_FROM, subject, text, html, senderName, senderEmail };

  if (process.env.BREVO_API_KEY) {
    try {
      const brevoRes = await tryBrevoWithRetry(brevoPayload, 3);
      return { ok: true, via: 'brevo', reason: null, meta: brevoRes };
    } catch (brevoErr) {
      console.error('Brevo final error', brevoErr && (brevoErr.status || brevoErr.message));
      const brevoMeta = { status: brevoErr.status, body: brevoErr.body, code: brevoErr.code };
      try {
        const safeSend = require('./verbose-email.js');
        const smtpRes = await safeSend({ to: brevoPayload.to, name, email, phone, details, senderName, senderEmail });
        return { ok: !!smtpRes.ok, via: 'smtp', reason: 'brevo-failed', meta: { brevo: brevoMeta, smtp: smtpRes } };
      } catch (smtpErr) {
        return { ok: false, via: 'none', reason: 'brevo-and-smtp-failed', meta: { brevo: brevoMeta, smtpError: String(smtpErr) } };
      }
    }
  }

  try {
    const safeSend = require('./verbose-email.js');
    const smtpRes = await safeSend({ to: process.env.EMAIL_FROM, name, email, phone, details, senderName, senderEmail });
    return { ok: !!smtpRes.ok, via: 'smtp', reason: null, meta: smtpRes };
  } catch (smtpErr) {
    return { ok: false, via: 'none', reason: 'smtp-failed', meta: { smtpError: String(smtpErr) } };
  }
}

module.exports = { trySendEmail };
